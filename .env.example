# Copy to .env and fill in. Never commit .env.

# --- Microsoft Foundry model inference (backend only) ---
# Copy the OpenAI-compatible inference base URL from the Foundry deployment.
# Include /openai/v1/; do not use the project URL ending /api/projects/<name>.
FOUNDRY_OPENAI_BASE_URL=https://<your-foundry-resource>.services.ai.azure.com/openai/v1/
FOUNDRY_API_KEY=
# Deployment names from Foundry Models > Deployments (not base model names)
FOUNDRY_CHAT_DEPLOYMENT=
FOUNDRY_EMBEDDING_DEPLOYMENT=

# --- Local Chroma vector store ---
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=nais-content

# --- Legacy Azure AI Search export only (optional) ---
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
# Admin key is required only for local index creation/upload; keep it on the backend.
AZURE_SEARCH_ADMIN_KEY=
# Use a query key for the deployed read-only chat API.
AZURE_SEARCH_QUERY_KEY=
AZURE_SEARCH_INDEX=nais-content

# --- RAG ---
DATA_DIR=content/chunks/basic-pages
CHUNK_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
TOP_K=4
# Below this best-match similarity the LLM is skipped and the fallback is returned
MIN_RELEVANCE_SCORE=0.3
NAIS_CONTACT_INFO=Please contact the NAIS team via the contact page on the website.

# --- API / security ---
# Comma-separated list of allowed browser origins (localhost is allowed in dev)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
# Also allow any http(s)://localhost[:port] / 127.0.0.1 origin. Set to false in production.
ALLOW_LOCALHOST=true
RATE_LIMIT=5/minute
LLM_TIMEOUT_SECONDS=20
MAX_OUTPUT_TOKENS=400

# --- Widget build time (read by Vite from widget/.env or the shell) ---
VITE_API_URL=http://localhost:8000

# --- Text-to-speech (Azure Speech / AI Services; backend only) ---
# Key falls back to FOUNDRY_API_KEY if unset (works for multi-service AI Services resources).
AZURE_SPEECH_KEY=
# Region of the resource, e.g. australiaeast. Or set a full endpoint instead:
AZURE_SPEECH_REGION=
# AZURE_SPEECH_ENDPOINT=https://<region>.tts.speech.microsoft.com/cognitiveservices/v1
AZURE_SPEECH_VOICE=en-NZ-MollyNeural
TTS_RATE_LIMIT=10/minute
