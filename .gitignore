# nais-chat-assistant
# Combined ignore rules for a Python FastAPI backend, a Vite React widget,
# and local ChromaDB / document data.

# --- Secrets and local env ---
.env
.env.*
!.env.example
*.pem
credentials.json
*-credentials.json
service-account*.json

# --- Python (backend/) ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
*.egg
*.egg-info/
.eggs/
pip-wheel-metadata/
.installed.cfg
develop-eggs/
*.manifest
*.spec

# Test, type-check, and lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# --- Node / TypeScript / Vite (widget/) ---
node_modules/
.vite/
dist/
dist-ssr/
*.local
*.tsbuildinfo
.eslintcache
.turbo/
.parcel-cache/

# npm / yarn / pnpm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Build and packaging output ---
build/
*.egg-info/
wheels/
share/python-wheels/
sdist/

# --- RAG data (generated, not source documents) ---
# Persist the vector store locally; do not commit it.
/chroma/
chroma_db/
.chroma/
**/chroma.sqlite3
data/chroma/
evaluation/chroma/db/
data/processed/
data/index/
evaluation/results/

# --- Local-only docs, drafts, and source website content ---
Claude outputs/

# --- Logs and runtime ---
*.log
logs/
*.pid

# --- OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Editors ---
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Deployable read-only vector store (baked into the Docker image)
!deploy/chroma-snapshot/
!deploy/chroma-snapshot/**

# --- MCP Azure Functions project: local settings may hold secrets ---
mcp_tools/mcp-server/local.settings.json

# --- Cloud identifiers and local-only notes (the repo is public) ---
# VS Code MCP client config holds the Function App host name and subscription id.
mcp_tools/mcp-server/.vscode/mcp.json
# Deployment guide and manual comparison notes are drafts, kept locally like docs/.
mcp_tools/mcp-server/*.docx
evaluation/*.rtf

# --- Local-only data and documents (not pushed) ---
# content/: website sources, reviewed chunks, embeddings, exports (derived, large)
content/
# docs/: drafts, proposals and guides
docs/
